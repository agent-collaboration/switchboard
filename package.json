{
	"name": "switchboard-workspace",
	"version": "0.0.1",
	"private": true,
	"description": "Switchboard tool access and sign-in packages",
	"license": "AGPL-3.0-only",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"type": "module",
	"imports": {
		"#auth-owner-cli": "./packages/sign-in-owner-cli/dist/index.js"
	},
	"scripts": {
		"build": "pnpm -r build",
		"clean": "git clean -fdX packages",
		"check:package-versions": "bash scripts/check-package-version-sync.sh",
		"check:zod": "node scripts/check-zod-version.ts",
		"generate:portal-contracts": "tsx scripts/generate-portal-contracts.ts",
		"python:sync": "uv sync --locked --all-packages",
		"python:fmt": "uv run ruff format python",
		"python:fmt:check": "uv run ruff format --check python",
		"python:lint": "uv run ruff check python",
		"python:typecheck": "pnpm python:typecheck:host",
		"python:typecheck:host": "uv run ty check python/agent-vm-agent-portal-sdk",
		"python:test": "pnpm python:test:host",
		"python:test:host": "uv run pytest python/agent-vm-agent-portal-sdk",
		"python:build": "uv build --all-packages",
		"python:publish": "bash scripts/publish-python-local.sh",
		"release:version": "tsx scripts/set-release-version.ts",
		"test:taxonomy": "tsx scripts/audit-test-taxonomy.ts",
		"test:cli-architecture": "tsx scripts/audit-optique-cli-boundaries.ts",
		"test:portal-architecture": "tsx scripts/audit-portal-architecture.ts",
		"test:portal-exports": "tsx scripts/verify-portal-package-exports.ts",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix",
		"lint:types": "oxlint --type-aware .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
		"check": "tsx scripts/run-check-gate.ts",
		"test": "pnpm test:unit",
		"test:unit": "pnpm test:taxonomy && vitest run --config vitest.config.ts --project unit",
		"test:integration": "vitest run --config vitest.config.ts --project integration",
		"test:e2e:host": "vitest run --config vitest.config.ts --project e2e-host",
		"test:e2e": "tsx scripts/run-e2e-proof-lanes.ts",
		"verify:sign-in": "tsx scripts/verify-auth/verify-auth.ts",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^25.6.2",
		"@vitest/utils": "4.1.5",
		"legacy-tool-portal": "npm:@agent-vm/tool-portal@0.0.153",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"tasuku": "^2.3.0",
		"tsdown": "^0.22.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.5",
		"zod": "4.4.3"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.33.0"
}
