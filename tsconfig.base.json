			],
			"@agent-collaboration/tool-access/contracts": [
				"./packages/tool-access/src/contracts/index.ts"
			],
			"@agent-collaboration/tool-access/authorization": [
				"./packages/tool-access/src/authorization/index.ts"
			],
			"@agent-collaboration/agent-portal-sdk": ["./packages/agent-portal-sdk/src/index.ts"],
