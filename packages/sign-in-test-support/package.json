{
	"name": "@agent-collaboration/sign-in-test-support",
	"version": "0.0.153",
	"private": true,
	"description": "Sign-in test hosts, controlled inputs and driver proofs.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/agent-collaboration/switchboard.git",
		"directory": "packages/sign-in-test-support"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"imports": {
		"#sign-in-test-support/*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@agent-collaboration/sign-in-core": "workspace:*",
		"@agent-collaboration/sign-in-host-cloudflare": "workspace:*",
		"@agent-collaboration/sign-in-host-node": "workspace:*",
		"@agent-collaboration/sign-in-owner-cli": "workspace:*",
		"@agent-collaboration/sign-in-platform-web": "workspace:*",
		"@agent-collaboration/tool-access": "workspace:*",
		"better-auth": "1.7.11",
		"better-sqlite3": "13.0.3",
		"drizzle-orm": "0.45.2",
		"esbuild": "0.28.1",
		"jose": "6.2.12",
		"miniflare": "5.20260815.0-alpha",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@better-auth/utils": "0.5.0",
		"@hegeldev/hegel": "0.4.10",
		"@levischuck/tiny-cbor": "0.2.11",
		"@simplewebauthn/server": "13.3.3",
		"@types/better-sqlite3": "9.6.0",
		"ajv": "8.18.0",
		"ajv-formats": "3.0.1",
		"auth": "1.7.11",
		"drizzle-kit": "0.31.11",
		"jsdom": "27.4.0",
		"jsonc-parser": "3.3.1",
		"typescript": "6.0.3",
		"uqr": "0.1.3",
		"vitest": "4.1.5",
		"wrangler": "4.124.0"
	}
}
