{
	"name": "@agent-collaboration/config-contracts",
	"version": "0.0.153",
	"description": "Shared Switchboard JSONC config schemas and TypeScript contracts.",
	"homepage": "https://github.com/agent-collaboration/switchboard#readme",
	"bugs": {
		"url": "https://github.com/agent-collaboration/switchboard/issues"
	},
	"license": "AGPL-3.0-only",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/agent-collaboration/switchboard.git",
		"directory": "packages/config-contracts"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "pnpm -C ../.. build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --root ../../ --config vitest.config.ts --project unit packages/config-contracts/src"
	},
	"dependencies": {
		"@agent-collaboration/oauth-broker-contracts": "workspace:*",
		"@agent-collaboration/tool-access": "workspace:*",
		"@agent-collaboration/tool-host-node": "workspace:*",
		"jsonc-parser": "^3.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"vitest": "^4.1.5"
	}
}
