					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
				},
				"aud": {
					"type": "string",
					"format": "uri",
					"description": "Exactly one relying-service audience; arrays are refused"
				},
				"exp": {
					"type": "integer",
